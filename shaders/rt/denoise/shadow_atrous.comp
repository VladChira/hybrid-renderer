#version 460 core

// One iteration of an à-trous bilateral filter over the shadow mask array.
// 3x3 kernel with stride 2^iteration. Edge stops on G-buffer depth and
// normal — layer loop is inside the shader so edge weights are computed
// once per neighbour.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(r16f, binding = 0) uniform writeonly image2DArray o_filtered;

uniform sampler2DArray u_mask_in;
uniform sampler2D      u_gbuffer_rt1;     // xyz = encoded normal
uniform sampler2D      u_gbuffer_depth;

uniform uvec2 u_output_size;
uniform uint  u_layer_count;
uniform int   u_stride;
uniform float u_depth_sigma;
uniform float u_normal_sigma;

const float kKernel3[3] = float[3](0.25, 0.5, 0.25);

// Maximum layer count must match kMaxShadowMaskLayers on the CPU side.
const uint kMaxLayers = 8u;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2 uv_center = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float center_depth = texture(u_gbuffer_depth, uv_center).r;

    if (center_depth >= 1.0)
    {
        for (uint layer = 0u; layer < u_layer_count; ++layer)
        {
            imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(1.0));
        }
        return;
    }

    vec3 center_normal = normalize(texture(u_gbuffer_rt1, uv_center).xyz * 2.0 - 1.0);

    float weighted_sum[kMaxLayers];
    float weight_sum = 0.0;
    for (uint i = 0u; i < kMaxLayers; ++i)
    {
        weighted_sum[i] = 0.0;
    }

    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec2 sample_pixel = pixel + ivec2(dx, dy) * u_stride;
            if (sample_pixel.x < 0 || sample_pixel.y < 0 ||
                sample_pixel.x >= int(u_output_size.x) ||
                sample_pixel.y >= int(u_output_size.y))
            {
                continue;
            }

            vec2 sample_uv = (vec2(sample_pixel) + vec2(0.5)) / vec2(u_output_size);
            float sample_depth = texture(u_gbuffer_depth, sample_uv).r;
            vec3  sample_normal = normalize(texture(u_gbuffer_rt1, sample_uv).xyz * 2.0 - 1.0);

            float depth_diff = abs(sample_depth - center_depth);
            float w_depth = exp(-depth_diff / max(u_depth_sigma, 1e-6));

            float ndotn = max(dot(center_normal, sample_normal), 0.0);
            float w_normal = pow(ndotn, u_normal_sigma);

            float w_kernel = kKernel3[dx + 1] * kKernel3[dy + 1];
            float w = w_depth * w_normal * w_kernel;

            for (uint layer = 0u; layer < u_layer_count; ++layer)
            {
                float sample_value = texture(u_mask_in, vec3(sample_uv, float(layer))).r;
                weighted_sum[layer] += sample_value * w;
            }
            weight_sum += w;
        }
    }

    for (uint layer = 0u; layer < u_layer_count; ++layer)
    {
        float filtered = weight_sum > 0.0 ? weighted_sum[layer] / weight_sum : 1.0;
        imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(filtered));
    }
}
