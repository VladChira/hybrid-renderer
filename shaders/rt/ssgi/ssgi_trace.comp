#version 460 core
#extension GL_ARB_bindless_texture : require

// Quarter-resolution screen-space GI with BVH fallback.
//
// Per pixel:
//   1. Reconstruct world position + normal from the G-buffer.
//   2. Sample a cosine-weighted hemisphere direction (stochastic, 1 spp).
//   3. Screen-space march against the G-buffer depth. On hit, read last
//      frame's linear HDR radiance at the hit UV.
//   4. If the screen-space ray misses, trace the BVH. If the BVH hits
//      geometry whose projection is visible on screen, sample last frame's
//      radiance there; otherwise fall back to the prefiltered IBL in the
//      ray direction (diffuse-ish approximation).
//   5. If the BVH misses entirely, use the IBL irradiance as the fallback.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2D o_ssgi;

#include "rt/common.glsl"
#include "rt/bvh_traversal.glsl"
#include "rt/geometry_fetch.glsl"
#include "rt/material_fetch.glsl"
#include "rt/random.glsl"

uniform sampler2D   u_gbuffer_depth;
uniform sampler2D   u_gbuffer_rt1;
uniform sampler2D   u_scene_radiance_prev;
uniform samplerCube u_irradiance_cubemap;

uniform mat4  u_view;
uniform mat4  u_projection;
uniform mat4  u_view_projection;
uniform mat4  u_inv_view;
uniform mat4  u_inv_projection;
uniform vec3  u_camera_position;

uniform uvec2 u_output_size;      // quarter-res
uniform uint  u_frame_index;
uniform uint  u_tlas_node_count;
uniform float u_max_ray_distance;
uniform float u_ssgi_intensity;
uniform float u_screen_march_thickness;
uniform uint  u_has_irradiance;
uniform float u_skybox_intensity;
uniform float u_skybox_yaw_radians;
uniform int   u_debug_mode;   // 0 = all tiers, 1 = only screen, 2 = only BVH, 3 = only IBL

const int kMaxScreenMarchSteps = 32;

vec3 ReconstructWorldPosFromUv(vec2 uv, float depth)
{
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = u_inv_projection * ndc;
    view /= max(view.w, 1e-5);
    return (u_inv_view * vec4(view.xyz, 1.0)).xyz;
}

bool ProjectToScreen(vec3 world_pos, out vec3 screen_xyz)
{
    vec4 clip = u_view_projection * vec4(world_pos, 1.0);
    if (clip.w <= 1e-4)
    {
        return false;
    }
    vec3 ndc = clip.xyz / clip.w;
    screen_xyz = vec3(ndc.xy * 0.5 + 0.5, ndc.z * 0.5 + 0.5);
    return true;
}

// Match the deferred-lighting HDRI rotation so the IBL fallback lines up.
vec3 RotateAroundY(vec3 direction, float angle_radians)
{
    float c = cos(angle_radians);
    float s = sin(angle_radians);
    return vec3(c * direction.x + s * direction.z,
                direction.y,
                -s * direction.x + c * direction.z);
}

vec3 IrradianceIn(vec3 direction)
{
    if (u_has_irradiance == 0u)
    {
        return vec3(0.0);
    }
    vec3 rotated = RotateAroundY(direction, u_skybox_yaw_radians);
    return texture(u_irradiance_cubemap, rotated).rgb * max(u_skybox_intensity, 0.0);
}

// Linear screen-space depth march. Returns true on hit and writes the hit UV.
bool ScreenMarch(vec3 origin_world, vec3 direction_world, out vec2 hit_uv)
{
    hit_uv = vec2(0.0);

    vec3 end_world = origin_world + direction_world * u_max_ray_distance;
    vec3 start_ss;
    vec3 end_ss;
    if (!ProjectToScreen(origin_world, start_ss) || !ProjectToScreen(end_world, end_ss))
    {
        return false;
    }

    vec3 ray_ss = end_ss - start_ss;
    if (length(ray_ss.xy) < 1e-5)
    {
        return false;
    }

    for (int i = 1; i <= kMaxScreenMarchSteps; ++i)
    {
        float t = float(i) / float(kMaxScreenMarchSteps);
        vec3 sample_ss = start_ss + ray_ss * t;

        if (any(lessThan(sample_ss.xy, vec2(0.0))) || any(greaterThan(sample_ss.xy, vec2(1.0))) || sample_ss.z >= 1.0)
        {
            return false;
        }

        float scene_depth = texture(u_gbuffer_depth, sample_ss.xy).r;
        float delta = sample_ss.z - scene_depth;
        if (delta > 0.0 && delta < u_screen_march_thickness)
        {
            hit_uv = sample_ss.xy;
            return true;
        }
    }
    return false;
}

vec3 ResolveBvhHitColor(RayHit hit, vec3 ray_direction)
{
    HitGeometry geo = FetchHitGeometry(hit);

    // Try to reuse last frame's screen radiance if the hit is visible.
    vec3 hit_ss;
    if (ProjectToScreen(geo.world_position, hit_ss))
    {
        if (all(greaterThanEqual(hit_ss.xy, vec2(0.0))) &&
            all(lessThanEqual(hit_ss.xy, vec2(1.0))) &&
            hit_ss.z < 1.0)
        {
            float screen_depth = texture(u_gbuffer_depth, hit_ss.xy).r;
            if (abs(screen_depth - hit_ss.z) < 0.005)
            {
                return texture(u_scene_radiance_prev, hit_ss.xy).rgb;
            }
        }
    }

    // Off-screen or occluded — approximate with IBL in the ray direction and
    // modulate by the hit surface's albedo so coloured bounces survive.
    ShadedSurface surface = FetchSurface(geo.material_index, geo.uv0, geo.uv1);
    return surface.albedo * IrradianceIn(ray_direction);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float depth = texture(u_gbuffer_depth, uv).r;
    if (depth >= 1.0)
    {
        imageStore(o_ssgi, pixel, vec4(0.0));
        return;
    }

    vec3 world_pos = ReconstructWorldPosFromUv(uv, depth);
    vec3 normal    = normalize(texture(u_gbuffer_rt1, uv).xyz * 2.0 - 1.0);

    vec2 rand = Hash2PerPixel(pixel, u_frame_index, 1u);
    vec3 direction = CosineWeightedHemisphere(normal, rand);

    // Nudge the ray origin along the normal so we don't self-intersect with
    // the surface we're shading.
    vec3 origin = world_pos + normal * 0.01;

    vec3 radiance = vec3(0.0);

    vec2 screen_hit_uv;
    bool screen_hit = ScreenMarch(origin, direction, screen_hit_uv);

    RayHit hit;
    bool bvh_hit = false;
    if (!screen_hit)
    {
        bvh_hit = TraceClosestHit(origin, direction, u_tlas_node_count, u_max_ray_distance, hit);
    }

    // Tier selection. Debug mode nukes whatever isn't being inspected so we
    // can see which tier is producing the signal we're looking at.
    if (screen_hit && (u_debug_mode == 0 || u_debug_mode == 1))
    {
        radiance = texture(u_scene_radiance_prev, screen_hit_uv).rgb;
    }
    else if (bvh_hit && (u_debug_mode == 0 || u_debug_mode == 2))
    {
        radiance = ResolveBvhHitColor(hit, direction);
    }
    else if (!screen_hit && !bvh_hit && (u_debug_mode == 0 || u_debug_mode == 3))
    {
        radiance = IrradianceIn(direction);
    }

    // Multiply by π so the stored value is directly comparable to the
    // preintegrated irradiance cubemap — the diffuse Monte-Carlo estimator
    // under cosine-weighted sampling reduces to π·L(ω_sample).
    imageStore(o_ssgi, pixel, vec4(radiance * (kPi * max(u_ssgi_intensity, 0.0)), 1.0));
}
