#version 460 core

// Temporal accumulation for the quarter-res SSGI output. Mirrors the shadow
// temporal pass but keeps an RGB signal.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2D o_history;

uniform sampler2D u_current;
uniform sampler2D u_history_prev;
uniform sampler2D u_gbuffer_depth;   // full-res, GL_NEAREST

uniform mat4  u_inv_view;
uniform mat4  u_inv_projection;
uniform mat4  u_prev_view_projection;

uniform uvec2 u_output_size;         // quarter-res
uniform float u_alpha;
uniform uint  u_history_valid;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);

    float depth = texture(u_gbuffer_depth, uv).r;

    bool reproject = (u_history_valid != 0u) && (depth < 1.0);
    vec2 prev_uv = vec2(0.0);

    if (reproject)
    {
        vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
        vec4 view = u_inv_projection * ndc;
        view /= max(view.w, 1e-5);
        vec3 world_pos = (u_inv_view * vec4(view.xyz, 1.0)).xyz;
        vec4 prev_clip = u_prev_view_projection * vec4(world_pos, 1.0);
        if (prev_clip.w > 1e-4)
        {
            vec3 prev_ndc = prev_clip.xyz / prev_clip.w;
            prev_uv = prev_ndc.xy * 0.5 + 0.5;
            if (any(lessThan(prev_uv, vec2(0.0))) || any(greaterThan(prev_uv, vec2(1.0))))
            {
                reproject = false;
            }
        }
        else
        {
            reproject = false;
        }
    }

    float alpha = reproject ? u_alpha : 0.0;
    vec3 current = texture(u_current, uv).rgb;
    vec3 history = reproject ? texture(u_history_prev, prev_uv).rgb : current;
    vec3 accumulated = mix(current, history, alpha);
    imageStore(o_history, pixel, vec4(accumulated, 1.0));
}
