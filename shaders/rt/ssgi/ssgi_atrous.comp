#version 460 core

// 3x3 à-trous bilateral filter over the quarter-res SSGI signal. Depth and
// normal edge stops are read from the full-res G-buffer.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2D o_filtered;

uniform sampler2D u_ssgi_in;
uniform sampler2D u_gbuffer_rt1;
uniform sampler2D u_gbuffer_depth;

uniform uvec2 u_output_size;
uniform int   u_stride;
uniform float u_depth_sigma;
uniform float u_normal_sigma;

const float kKernel3[3] = float[3](0.25, 0.5, 0.25);

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2 uv_center = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float center_depth = texture(u_gbuffer_depth, uv_center).r;
    if (center_depth >= 1.0)
    {
        imageStore(o_filtered, pixel, vec4(0.0));
        return;
    }

    vec3 center_normal = normalize(texture(u_gbuffer_rt1, uv_center).xyz * 2.0 - 1.0);

    vec3  weighted_sum = vec3(0.0);
    float weight_sum   = 0.0;

    for (int dy = -1; dy <= 1; ++dy)
    {
        for (int dx = -1; dx <= 1; ++dx)
        {
            ivec2 sp = pixel + ivec2(dx, dy) * u_stride;
            if (sp.x < 0 || sp.y < 0 ||
                sp.x >= int(u_output_size.x) || sp.y >= int(u_output_size.y))
            {
                continue;
            }

            vec2 sample_uv = (vec2(sp) + vec2(0.5)) / vec2(u_output_size);
            float sample_depth = texture(u_gbuffer_depth, sample_uv).r;
            vec3  sample_normal = normalize(texture(u_gbuffer_rt1, sample_uv).xyz * 2.0 - 1.0);

            float depth_diff = abs(sample_depth - center_depth);
            float w_depth = exp(-depth_diff / max(u_depth_sigma, 1e-6));

            float ndotn = max(dot(center_normal, sample_normal), 0.0);
            float w_normal = pow(ndotn, u_normal_sigma);

            float w_kernel = kKernel3[dx + 1] * kKernel3[dy + 1];
            float w = w_depth * w_normal * w_kernel;

            vec3 sample_value = texture(u_ssgi_in, sample_uv).rgb;
            weighted_sum += sample_value * w;
            weight_sum   += w;
        }
    }

    vec3 filtered = weight_sum > 0.0 ? weighted_sum / weight_sum : vec3(0.0);
    imageStore(o_filtered, pixel, vec4(filtered, 1.0));
}
