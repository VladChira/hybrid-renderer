#version 460 core

// One dispatch per shadow-casting light. Writes R8 visibility ∈ {0, 1} (hard
// shadow for directional/point, stochastic 1-spp for area) into a specific
// layer of the shadow mask array.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(r8, binding = 0) uniform writeonly image2D o_shadow_mask;

#include "rt/common.glsl"
#include "rt/bvh_traversal.glsl"
#include "rt/random.glsl"

uniform sampler2D u_gbuffer_rt1;
uniform sampler2D u_gbuffer_depth;

uniform mat4  u_inv_view;
uniform mat4  u_inv_projection;
uniform vec3  u_camera_position;

uniform uint  u_tlas_node_count;
uniform uvec2 u_output_size;
uniform uint  u_frame_index;
uniform float u_normal_bias;

// 0 = directional, 1 = point, 2 = area
uniform uint  u_light_type;
uniform vec3  u_light_direction;   // directional, area (surface normal)
uniform vec3  u_light_position;    // point, area
uniform vec2  u_light_size;        // area

vec3 ReconstructWorldPos(vec2 uv, float depth)
{
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = u_inv_projection * ndc;
    view /= max(view.w, 1e-5);
    return (u_inv_view * vec4(view.xyz, 1.0)).xyz;
}

void BuildBasis(vec3 n, out vec3 tangent, out vec3 bitangent)
{
    vec3 helper = abs(n.y) < 0.999 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
    tangent   = normalize(cross(helper, n));
    bitangent = normalize(cross(n, tangent));
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float depth = texture(u_gbuffer_depth, uv).r;
    if (depth >= 1.0)
    {
        imageStore(o_shadow_mask, pixel, vec4(1.0));
        return;
    }

    vec3 world_pos = ReconstructWorldPos(uv, depth);
    vec3 normal    = normalize(texture(u_gbuffer_rt1, uv).xyz * 2.0 - 1.0);

    vec3 L;
    float t_max;

    if (u_light_type == 0u)
    {
        L = normalize(-u_light_direction);
        t_max = 1e30;
    }
    else if (u_light_type == 1u)
    {
        vec3 light_vec = u_light_position - world_pos;
        float d = length(light_vec);
        if (d <= 1e-5)
        {
            imageStore(o_shadow_mask, pixel, vec4(1.0));
            return;
        }
        L = light_vec / d;
        t_max = d;
    }
    else
    {
        vec3 n = normalize(u_light_direction);
        vec3 t_axis, b_axis;
        BuildBasis(n, t_axis, b_axis);
        vec2 jitter = Hash2PerPixel(pixel, u_frame_index, 0u) - vec2(0.5);
        vec3 sample_pos = u_light_position +
                          jitter.x * u_light_size.x * t_axis +
                          jitter.y * u_light_size.y * b_axis;
        vec3 light_vec = sample_pos - world_pos;
        float d = length(light_vec);
        if (d <= 1e-5)
        {
            imageStore(o_shadow_mask, pixel, vec4(1.0));
            return;
        }
        L = light_vec / d;
        t_max = d;
    }

    // Back-facing to the light — the deferred shader already multiplies by
    // max(N·L, 0), so writing lit here has no effect on the final colour.
    if (dot(normal, L) <= 0.0)
    {
        imageStore(o_shadow_mask, pixel, vec4(1.0));
        return;
    }

    vec3 shadow_origin = world_pos + normal * u_normal_bias;
    float shadow_t_max = t_max - u_normal_bias * 2.0;
    if (shadow_t_max <= 0.0)
    {
        imageStore(o_shadow_mask, pixel, vec4(1.0));
        return;
    }

    bool occluded = TraceAnyHit(shadow_origin, L, u_tlas_node_count, shadow_t_max);
    imageStore(o_shadow_mask, pixel, vec4(occluded ? 0.0 : 1.0));
}
