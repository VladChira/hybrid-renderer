#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(r16f, binding = 0) uniform writeonly image2DArray o_history;

uniform sampler2DArray u_mask_current;
uniform sampler2DArray u_history_prev;
uniform sampler2D u_gbuffer_depth;

uniform mat4 u_inv_view;
uniform mat4 u_inv_projection;
uniform mat4 u_prev_view_projection;

uniform uvec2 u_output_size;    // dispatch size (half-res when half-res is on)
uniform uvec2 u_gbuffer_size;   // full-res gbuffer dimensions
uniform uint u_layer_count;
uniform uint u_denoise_layer_mask;
uniform float u_alpha;
uniform uint u_history_valid;

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    ivec2 scale = ivec2(u_gbuffer_size) / ivec2(u_output_size);
    ivec2 gbuffer_pixel = pixel * scale;
    vec2 gb_uv = (vec2(gbuffer_pixel) + vec2(0.5)) / vec2(u_gbuffer_size);
    float depth = texelFetch(u_gbuffer_depth, gbuffer_pixel, 0).r;

    bool reproject = (u_history_valid != 0u) && (depth < 1.0);
    vec2 prev_uv = vec2(0.0);

    if (reproject)
    {
        vec4 ndc = vec4(gb_uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
        vec4 view = u_inv_projection * ndc;
        view /= max(view.w, 1e-5);
        vec3 world_pos = (u_inv_view * vec4(view.xyz, 1.0)).xyz;

        vec4 prev_clip = u_prev_view_projection * vec4(world_pos, 1.0);
        if (prev_clip.w > 1e-4)
        {
            vec3 prev_ndc = prev_clip.xyz / prev_clip.w;
            prev_uv = prev_ndc.xy * 0.5 + 0.5;
            if (any(lessThan(prev_uv, vec2(0.0))) || any(greaterThan(prev_uv, vec2(1.0))))
            {
                reproject = false;
            }
        }
        else
        {
            reproject = false;
        }
    }

    float alpha = reproject ? clamp(u_alpha, 0.0, 0.999) : 0.0;
    for (uint layer = 0u; layer < u_layer_count; ++layer)
    {
        float current = texture(u_mask_current, vec3(uv, float(layer))).r;
        bool should_denoise = (u_denoise_layer_mask & (1u << layer)) != 0u;
        if (!should_denoise)
        {
            imageStore(o_history, ivec3(pixel, int(layer)), vec4(current));
            continue;
        }

        float history = reproject
                            ? texture(u_history_prev, vec3(prev_uv, float(layer))).r
                            : current;
        float accumulated = mix(current, history, alpha);
        imageStore(o_history, ivec3(pixel, int(layer)), vec4(accumulated));
    }
}
