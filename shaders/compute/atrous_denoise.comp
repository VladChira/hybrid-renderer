#version 460 core

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(r16f, binding = 0) uniform writeonly image2DArray o_filtered;

uniform sampler2DArray u_input_signal;
uniform sampler2D u_gbuffer_rt1;
uniform sampler2D u_gbuffer_depth;

uniform uvec2 u_output_size;     // dispatch size (half-res when half-res is on)
uniform uvec2 u_gbuffer_size;    // full-res gbuffer dimensions
uniform uint u_layer_count;
uniform uint u_denoise_layer_mask;
uniform int u_stepwidth;
uniform float u_c_phi;
uniform float u_n_phi;
uniform float u_p_phi;

const int kKernelSize = 9;
const float kKernel[kKernelSize] = float[](
    1.0 / 16.0, 1.0 / 8.0, 1.0 / 16.0,
    1.0 / 8.0,  1.0 / 4.0, 1.0 / 8.0,
    1.0 / 16.0, 1.0 / 8.0, 1.0 / 16.0
);
const ivec2 kOffset[kKernelSize] = ivec2[](
    ivec2(-1, -1), ivec2( 0, -1), ivec2( 1, -1),
    ivec2(-1,  0), ivec2( 0,  0), ivec2( 1,  0),
    ivec2(-1,  1), ivec2( 0,  1), ivec2( 1,  1)
);

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    ivec2 scale = ivec2(u_gbuffer_size) / ivec2(u_output_size);
    ivec2 gbuffer_pixel_center = pixel * scale;
    float depth_center = texelFetch(u_gbuffer_depth, gbuffer_pixel_center, 0).r;
    vec3 normal_center = normalize(texelFetch(u_gbuffer_rt1, gbuffer_pixel_center, 0).xyz * 2.0 - 1.0);

    ivec2 max_coord = ivec2(u_output_size) - ivec2(1);
    for (uint layer = 0u; layer < u_layer_count; ++layer)
    {
        float center = texelFetch(u_input_signal, ivec3(pixel, int(layer)), 0).r;
        bool should_denoise = (u_denoise_layer_mask & (1u << layer)) != 0u;
        if (!should_denoise)
        {
            imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(center));
            continue;
        }

        if (depth_center >= 1.0)
        {
            imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(center));
            continue;
        }

        float sum = 0.0;
        float cum_w = 0.0;
        for (int i = 0; i < kKernelSize; ++i)
        {
            ivec2 sample_coord = clamp(pixel + kOffset[i] * u_stepwidth, ivec2(0), max_coord);
            ivec2 gbuffer_sample = sample_coord * scale;
            float depth_sample = texelFetch(u_gbuffer_depth, gbuffer_sample, 0).r;
            if (depth_sample >= 1.0)
            {
                continue;
            }

            vec3 normal_sample = normalize(texelFetch(u_gbuffer_rt1, gbuffer_sample, 0).xyz * 2.0 - 1.0);
            float n_w = max(dot(normal_center, normal_sample), 0.0);
            if (n_w < 1e-3)
            {
                continue;
            }

            float value = texelFetch(u_input_signal, ivec3(sample_coord, int(layer)), 0).r;
            float c_diff = center - value;
            float c_w = max(1.0 - (c_diff * c_diff) / max(u_c_phi, 1e-6), 0.0);
            float p_w = max(1.0 - abs(depth_center - depth_sample) / max(u_p_phi, 1e-6), 0.0);
            float weight = c_w * p_w * pow(n_w, max(u_n_phi, 1.0)) * kKernel[i];

            sum += value * weight;
            cum_w += weight;
        }

        float filtered = (cum_w > 1e-6) ? (sum / cum_w) : center;
        imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(filtered));
    }
}

