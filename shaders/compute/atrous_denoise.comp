#version 460 core

// SVGF-style edge-avoiding a-trous wavelet filter. Per-pixel luminance
// bandwidth is driven from the temporally-accumulated variance, so the filter
// auto-tightens where the signal has converged and is permissive where it is
// still noisy. Variance is filtered alongside the mean using kernel-squared
// weights (per Schied et al. 2017).

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rg16f, binding = 0) uniform writeonly image2DArray o_filtered;

uniform sampler2DArray u_input_signal;     // (m1, variance)
uniform sampler2D u_gbuffer_rt1;
uniform sampler2D u_gbuffer_depth;

uniform uvec2 u_output_size;
uniform uint  u_layer_count;
uniform uint  u_denoise_layer_mask;
uniform int   u_stepwidth;
uniform float u_sigma_l;     // luminance bandwidth multiplier
uniform float u_n_phi;       // normal weight exponent
uniform float u_p_phi;       // depth bandwidth (relative to linear z)
uniform float u_camera_near;
uniform float u_camera_far;

const int kKernelSize = 9;
const float kKernel[kKernelSize] = float[](
    1.0 / 16.0, 1.0 / 8.0, 1.0 / 16.0,
    1.0 / 8.0,  1.0 / 4.0, 1.0 / 8.0,
    1.0 / 16.0, 1.0 / 8.0, 1.0 / 16.0
);
const ivec2 kOffset[kKernelSize] = ivec2[](
    ivec2(-1, -1), ivec2( 0, -1), ivec2( 1, -1),
    ivec2(-1,  0), ivec2( 0,  0), ivec2( 1,  0),
    ivec2(-1,  1), ivec2( 0,  1), ivec2( 1,  1)
);

float LinearizeDepth(float ndc_z)
{
    float z_n = ndc_z * 2.0 - 1.0;
    return (2.0 * u_camera_near * u_camera_far) /
           (u_camera_far + u_camera_near - z_n * (u_camera_far - u_camera_near));
}

vec3 DecodeNormal(vec3 enc)
{
    return normalize(enc * 2.0 - 1.0);
}

// 3x3 Gaussian pre-filter on the variance channel for stability. Without this
// the per-pixel bandwidth itself is noisy and the filter underperforms.
float PreblurVariance(int layer)
{
    ivec2 max_coord = ivec2(u_output_size) - ivec2(1);
    ivec2 base = ivec2(gl_GlobalInvocationID.xy);
    float sum = 0.0;
    float wsum = 0.0;
    for (int j = -1; j <= 1; ++j)
    {
        for (int i = -1; i <= 1; ++i)
        {
            ivec2 c = clamp(base + ivec2(i, j), ivec2(0), max_coord);
            float w = (i == 0 && j == 0) ? 4.0 : ((i == 0 || j == 0) ? 2.0 : 1.0);
            float v = texelFetch(u_input_signal, ivec3(c, layer), 0).g;
            sum += v * w;
            wsum += w;
        }
    }
    return sum / max(wsum, 1e-6);
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    float depth_center_ndc = texelFetch(u_gbuffer_depth, pixel, 0).r;
    bool sky = depth_center_ndc >= 1.0;
    vec3 normal_center = DecodeNormal(texelFetch(u_gbuffer_rt1, pixel, 0).xyz);
    float linear_z_center = LinearizeDepth(depth_center_ndc);
    ivec2 max_coord = ivec2(u_output_size) - ivec2(1);

    for (uint layer = 0u; layer < u_layer_count; ++layer)
    {
        vec2 mv_center = texelFetch(u_input_signal, ivec3(pixel, int(layer)), 0).rg;
        bool should_denoise = (u_denoise_layer_mask & (1u << layer)) != 0u;
        if (!should_denoise || sky)
        {
            imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(mv_center.x, mv_center.y, 0.0, 0.0));
            continue;
        }

        float center = mv_center.x;
        float var_blurred = PreblurVariance(int(layer));
        float sigma_l = u_sigma_l * sqrt(max(var_blurred, 0.0)) + 1e-4;
        float depth_scale = max(linear_z_center * u_p_phi, 1e-4);

        float sum_m = 0.0;
        float sum_v = 0.0;
        float cum_w = 0.0;
        float cum_w2 = 0.0;

        for (int i = 0; i < kKernelSize; ++i)
        {
            ivec2 sample_coord = clamp(pixel + kOffset[i] * u_stepwidth, ivec2(0), max_coord);
            float depth_sample_ndc = texelFetch(u_gbuffer_depth, sample_coord, 0).r;
            if (depth_sample_ndc >= 1.0)
            {
                continue;
            }

            vec3 normal_sample = DecodeNormal(texelFetch(u_gbuffer_rt1, sample_coord, 0).xyz);
            float n_dot = max(dot(normal_center, normal_sample), 0.0);
            float n_w = pow(n_dot, max(u_n_phi, 1.0));
            if (n_w < 1e-3)
            {
                continue;
            }

            float linear_z_sample = LinearizeDepth(depth_sample_ndc);
            float dz = abs(linear_z_center - linear_z_sample) / depth_scale;
            float p_w = exp(-dz);

            vec2 mv = texelFetch(u_input_signal, ivec3(sample_coord, int(layer)), 0).rg;
            float c_diff = abs(center - mv.x);
            float c_w = exp(-c_diff / sigma_l);

            float k = kKernel[i];
            float w = c_w * p_w * n_w * k;

            sum_m += mv.x * w;
            sum_v += mv.y * (w * w);
            cum_w += w;
            cum_w2 += w * w;
        }

        float filtered_m = (cum_w > 1e-6) ? (sum_m / cum_w) : center;
        float filtered_v = (cum_w2 > 1e-6) ? (sum_v / cum_w2) : mv_center.y;

        imageStore(o_filtered, ivec3(pixel, int(layer)), vec4(filtered_m, filtered_v, 0.0, 0.0));
    }
}
