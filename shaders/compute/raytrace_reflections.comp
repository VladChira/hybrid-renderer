#version 460 core
#extension GL_ARB_bindless_texture : require

// One-sample reflection pass. Traces a uniform-hemisphere ray per pixel and
// weights by the Cook-Torrance specular BRDF / PDF to produce an unbiased
// (but very noisy) Monte Carlo estimate of the specular reflection integral.
// Downstream temporal + A-Trous filtering stabilises the result.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2D o_reflection_radiance;

uniform sampler2D   u_gbuffer_rt0;
uniform sampler2D   u_gbuffer_rt1;
uniform sampler2D   u_gbuffer_depth;
uniform samplerCube u_skybox_cubemap;
uniform samplerCube u_irradiance_cubemap;
uniform samplerCube u_prefiltered_env_cubemap;
uniform sampler2D   u_brdf_lut;

#include "include/bvh_traversal.glsl"
#include "include/geometry_fetch.glsl"
#include "include/material_fetch.glsl"
#include "include/random.glsl"

uniform mat4  u_inv_view;
uniform mat4  u_inv_projection;
uniform vec3  u_camera_position;
uniform uint  u_tlas_node_count;
uniform uint  u_frame_index;
uniform uvec2 u_output_size;
uniform float u_normal_bias;

uniform int   u_has_skybox;
uniform int   u_has_irradiance;
uniform int   u_has_prefiltered_env;
uniform int   u_has_specular_ibl;
uniform float u_skybox_intensity;
uniform float u_skybox_yaw_radians;

const float kMaxReflectionLod    = 7.0;
const uint  kMaxTransparentLayers = 8u;
const float kPi                  = 3.14159265359;
const float kRadianceClamp       = 32.0;

vec3 ReconstructWorldPosition(vec2 uv, float depth)
{
    vec4 ndc  = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = u_inv_projection * ndc;
    view /= max(view.w, 1e-5);
    return (u_inv_view * vec4(view.xyz, 1.0)).xyz;
}

vec3 RotateAroundY(vec3 d, float angle)
{
    float c = cos(angle);
    float s = sin(angle);
    return vec3(c * d.x + s * d.z, d.y, -s * d.x + c * d.z);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (vec3(1.0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 FresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

float DistributionGGX(float ndoth, float roughness)
{
    float a  = roughness * roughness;
    float a2 = a * a;
    float d  = ndoth * ndoth * (a2 - 1.0) + 1.0;
    return a2 / max(kPi * d * d, 1e-5);
}

float GeometrySchlickGGX(float ndotv, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return ndotv / max(ndotv * (1.0 - k) + k, 1e-5);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    return GeometrySchlickGGX(max(dot(N, V), 0.0), roughness) *
           GeometrySchlickGGX(max(dot(N, L), 0.0), roughness);
}

vec3 SampleEnvironment(vec3 direction, float roughness)
{
    vec3  rotated   = RotateAroundY(normalize(direction), u_skybox_yaw_radians);
    float intensity = max(u_skybox_intensity, 0.0);

    if (u_has_prefiltered_env != 0)
    {
        return textureLod(u_prefiltered_env_cubemap,
                          rotated,
                          clamp(roughness, 0.0, 1.0) * kMaxReflectionLod).rgb * intensity;
    }
    if (u_has_skybox != 0)
    {
        return texture(u_skybox_cubemap, rotated).rgb * intensity;
    }
    return vec3(0.0);
}

vec3 ShadeHit(HitGeometry geo, ShadedSurface surface, vec3 view_direction)
{
    mat3 tbn    = BuildHitTbn(geo);
    vec3 N      = normalize(tbn * surface.normal_tangent);
    vec3 V      = normalize(view_direction);
    if (dot(N, V) < 0.0)
    {
        N = -N;
    }

    float ndotv = max(dot(N, V), 0.0);
    vec3  F0    = mix(vec3(0.04), surface.albedo, surface.metallic);
    vec3  F     = FresnelSchlickRoughness(ndotv, F0, surface.roughness);
    vec3  kS    = F;
    vec3  kD    = (vec3(1.0) - kS) * (1.0 - surface.metallic);

    vec3 radiance = surface.emissive;

    if (u_has_irradiance != 0)
    {
        vec3 irr_dir   = RotateAroundY(N, u_skybox_yaw_radians);
        vec3 irradiance = texture(u_irradiance_cubemap, irr_dir).rgb * max(u_skybox_intensity, 0.0);
        radiance += kD * irradiance * surface.albedo;
    }

    if (u_has_specular_ibl != 0)
    {
        vec3  R           = reflect(-V, N);
        vec3  prefiltered = SampleEnvironment(R, surface.roughness);
        vec2  env_brdf    = texture(u_brdf_lut, vec2(ndotv, clamp(surface.roughness, 0.0, 1.0))).rg;
        radiance += prefiltered * (F * env_brdf.x + env_brdf.y);
    }

    return radiance;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2  uv    = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float depth = texture(u_gbuffer_depth, uv).r;
    if (depth >= 1.0)
    {
        imageStore(o_reflection_radiance, pixel, vec4(0.0));
        return;
    }

    vec4  rt0      = texture(u_gbuffer_rt0, uv);
    vec4  rt1      = texture(u_gbuffer_rt1, uv);
    vec3  normal   = normalize(rt1.xyz * 2.0 - 1.0);
    vec3  albedo   = clamp(rt0.rgb, 0.0, 1.0);
    float metallic = clamp(rt0.a,   0.0, 1.0);
    float roughness = clamp(rt1.a,  0.0, 1.0);

    vec3 world_pos = ReconstructWorldPosition(uv, depth);
    vec3 V         = normalize(u_camera_position - world_pos);
    float ndotv    = max(dot(normal, V), 0.0);
    if (ndotv <= 1e-4)
    {
        imageStore(o_reflection_radiance, pixel, vec4(0.0));
        return;
    }

    // Uniform hemisphere sample around the surface normal.
    vec2  Xi        = Hash2PerPixel(pixel, u_frame_index, 1u);
    float phi       = 2.0 * kPi * Xi.x;
    float cos_theta = Xi.y;
    float sin_theta = sqrt(max(1.0 - cos_theta * cos_theta, 0.0));
    vec3  H_local   = vec3(cos(phi) * sin_theta, sin(phi) * sin_theta, cos_theta);

    vec3 up      = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, normal));
    vec3 bitan   = cross(normal, tangent);
    vec3 L       = normalize(tangent * H_local.x + bitan * H_local.y + normal * H_local.z);

    float ndotl = max(dot(normal, L), 0.0);
    if (ndotl <= 1e-4)
    {
        imageStore(o_reflection_radiance, pixel, vec4(0.0));
        return;
    }

    vec3 F0      = mix(vec3(0.04), albedo, metallic);
    vec3 ray_origin = world_pos + normal * u_normal_bias + L * u_normal_bias;

    // Default to environment in the sampled direction.
    vec3 incident_radiance = SampleEnvironment(L, 0.0);

    for (uint layer = 0u; layer < kMaxTransparentLayers; ++layer)
    {
        RayHit hit;
        if (!TraceClosestHit(ray_origin, L, u_tlas_node_count, 1e30, hit))
        {
            break;
        }

        HitGeometry geo = FetchHitGeometry(hit, ray_origin, L);
        if (!PassesAlphaTest(geo.material_index, geo.uv0, geo.uv1))
        {
            ray_origin = geo.world_position + L * u_normal_bias;
            continue;
        }

        ShadedSurface surface = FetchSurface(geo.material_index, geo.uv0, geo.uv1);
        incident_radiance     = ShadeHit(geo, surface, -L);
        break;
    }

    // Cook-Torrance specular BRDF weight for uniform hemisphere sampling.
    // weight = BRDF(L,V,N) * ndotl / PDF
    //        = D*G*F / (4*ndotl*ndotv) * ndotl * 2*pi
    //        = D*G*F*pi / (2*ndotv)
    vec3  H     = normalize(V + L);
    float ndoth = max(dot(normal, H), 0.0);
    float hdotv = max(dot(H, V),      0.0);

    vec3  F = FresnelSchlick(hdotv, F0);
    float D = DistributionGGX(ndoth, roughness);
    float G = GeometrySmith(normal, V, L, roughness);

    vec3 weight = D * G * F * kPi / max(2.0 * ndotv, 1e-4);

    vec3 reflection = clamp(incident_radiance * weight, 0.0, kRadianceClamp);
    imageStore(o_reflection_radiance, pixel, vec4(reflection, 1.0));
}
