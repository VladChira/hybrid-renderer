#version 460 core
#extension GL_ARB_bindless_texture : require

// One-bounce reflection radiance. Smooth surfaces trace a deterministic mirror
// ray, while rough surfaces trace one GGX importance-sampled ray per pixel per
// frame. The pass writes a noisy Monte Carlo estimate that downstream temporal
// accumulation + A-Trous filtering stabilise.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2D o_reflection_radiance;

uniform sampler2D   u_gbuffer_rt0;
uniform sampler2D   u_gbuffer_rt1;
uniform sampler2D   u_gbuffer_depth;
uniform samplerCube u_skybox_cubemap;
uniform samplerCube u_irradiance_cubemap;
uniform samplerCube u_prefiltered_env_cubemap;
uniform sampler2D   u_brdf_lut;

#include "include/common.glsl"
#include "include/bvh_traversal.glsl"
#include "include/geometry_fetch.glsl"
#include "include/material_fetch.glsl"
#include "include/random.glsl"

uniform mat4  u_inv_view;
uniform mat4  u_inv_projection;
uniform vec3  u_camera_position;
uniform uint  u_tlas_node_count;
uniform uint  u_frame_index;
uniform uvec2 u_output_size;
uniform float u_normal_bias;

uniform int   u_has_skybox;
uniform int   u_has_irradiance;
uniform int   u_has_prefiltered_env;
uniform int   u_has_specular_ibl;
uniform float u_skybox_intensity;
uniform float u_skybox_yaw_radians;

const float kMaxReflectionLod = 7.0;
const uint  kMaxTransparentLayers = 8u;
const float kPi = 3.14159265359;
const float kMirrorRoughnessThreshold = 0.02;
const float kMinSampleRoughness = 0.05;
const float kRadianceClamp = 32.0;

vec3 ReconstructWorldPosition(vec2 uv, float depth)
{
    vec4 ndc = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    vec4 view = u_inv_projection * ndc;
    view /= max(view.w, 1e-5);
    return (u_inv_view * vec4(view.xyz, 1.0)).xyz;
}

vec3 RotateAroundY(vec3 direction, float angle_radians)
{
    float c = cos(angle_radians);
    float s = sin(angle_radians);
    return vec3(c * direction.x + s * direction.z,
                direction.y,
                -s * direction.x + c * direction.z);
}

vec3 FresnelSchlickRoughness(float cosTheta, vec3 F0, float roughness)
{
    return F0 + (max(vec3(1.0 - roughness), F0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 FresnelSchlick(float cosTheta, vec3 F0)
{
    return F0 + (vec3(1.0) - F0) * pow(clamp(1.0 - cosTheta, 0.0, 1.0), 5.0);
}

vec3 SampleEnvironmentIncidentRadiance(vec3 direction, float roughness)
{
    vec3 rotated_direction = RotateAroundY(normalize(direction), u_skybox_yaw_radians);
    float intensity = max(u_skybox_intensity, 0.0);

    if (u_has_prefiltered_env != 0)
    {
        return textureLod(u_prefiltered_env_cubemap,
                          rotated_direction,
                          clamp(roughness, 0.0, 1.0) * kMaxReflectionLod).rgb * intensity;
    }

    if (u_has_skybox != 0)
    {
        return texture(u_skybox_cubemap, rotated_direction).rgb * intensity;
    }

    return vec3(0.0);
}

vec3 SampleEnvironmentDirectionRadiance(vec3 direction)
{
    vec3 rotated_direction = RotateAroundY(normalize(direction), u_skybox_yaw_radians);
    float intensity = max(u_skybox_intensity, 0.0);

    if (u_has_skybox != 0)
    {
        return texture(u_skybox_cubemap, rotated_direction).rgb * intensity;
    }

    if (u_has_prefiltered_env != 0)
    {
        return textureLod(u_prefiltered_env_cubemap, rotated_direction, 0.0).rgb * intensity;
    }

    return vec3(0.0);
}

float DistributionGGX(float ndoth, float roughness)
{
    float a = roughness * roughness;
    float a2 = a * a;
    float denom = ndoth * ndoth * (a2 - 1.0) + 1.0;
    return a2 / max(kPi * denom * denom, 1e-5);
}

float GeometrySchlickGGX(float ndotv, float roughness)
{
    float r = roughness + 1.0;
    float k = (r * r) / 8.0;
    return ndotv / max(ndotv * (1.0 - k) + k, 1e-5);
}

float GeometrySmith(vec3 N, vec3 V, vec3 L, float roughness)
{
    float ndotv = max(dot(N, V), 0.0);
    float ndotl = max(dot(N, L), 0.0);
    return GeometrySchlickGGX(ndotv, roughness) * GeometrySchlickGGX(ndotl, roughness);
}

vec3 ImportanceSampleGGX(vec2 Xi, vec3 N, float roughness)
{
    float a = roughness * roughness;
    float phi = 2.0 * kPi * Xi.x;
    float cosTheta = sqrt((1.0 - Xi.y) / max(1.0 + ((a * a) - 1.0) * Xi.y, 1e-5));
    float sinTheta = sqrt(max(1.0 - cosTheta * cosTheta, 0.0));

    vec3 H = vec3(cos(phi) * sinTheta, sin(phi) * sinTheta, cosTheta);

    vec3 up = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitangent = cross(N, tangent);
    return normalize(tangent * H.x + bitangent * H.y + N * H.z);
}

struct ReflectionSample
{
    vec3 direction;
    vec3 weight;
};

ReflectionSample SamplePrimaryReflection(ivec2 pixel,
                                         vec3 normal,
                                         vec3 view_direction,
                                         vec3 F0,
                                         float roughness)
{
    ReflectionSample sample;
    sample.direction = reflect(-view_direction, normal);
    sample.weight = vec3(0.0);

    float ndotv = max(dot(normal, view_direction), 0.0);
    if (ndotv <= 1e-4)
    {
        return sample;
    }

    if (roughness <= kMirrorRoughnessThreshold)
    {
        sample.direction = normalize(sample.direction);
        sample.weight = FresnelSchlick(ndotv, F0);
        return sample;
    }

    float sample_roughness = max(roughness, kMinSampleRoughness);
    vec2 Xi = Hash2PerPixel(pixel, u_frame_index, 0u);
    vec3 H = ImportanceSampleGGX(Xi, normal, sample_roughness);
    vec3 L = normalize(reflect(-view_direction, H));

    float ndotl = max(dot(normal, L), 0.0);
    float ndoth = max(dot(normal, H), 0.0);
    float hdotv = max(dot(H, view_direction), 0.0);
    if (ndotl <= 1e-4 || ndoth <= 1e-4 || hdotv <= 1e-4)
    {
        sample.direction = L;
        return sample;
    }

    vec3 F = FresnelSchlick(hdotv, F0);
    float D = DistributionGGX(ndoth, sample_roughness);
    float G = GeometrySmith(normal, view_direction, L, sample_roughness);
    float pdf = max(D * ndoth / max(4.0 * hdotv, 1e-4), 1e-4);
    vec3 specular_brdf = (D * G * F) / max(4.0 * ndotv * ndotl, 1e-4);

    sample.direction = L;
    sample.weight = specular_brdf * ndotl / pdf;
    return sample;
}

vec3 ShadeSecondaryHit(HitGeometry geo, ShadedSurface surface, vec3 view_direction)
{
    mat3 tbn = BuildHitTbn(geo);
    vec3 normal = normalize(tbn * surface.normal_tangent);
    vec3 V = normalize(view_direction);
    if (dot(normal, V) < 0.0)
    {
        normal = -normal;
    }

    float ndotv = max(dot(normal, V), 0.0);
    vec3 F0 = mix(vec3(0.04), surface.albedo, surface.metallic);
    vec3 F = FresnelSchlickRoughness(ndotv, F0, surface.roughness);
    vec3 kS = F;
    vec3 kD = (vec3(1.0) - kS) * (1.0 - surface.metallic);

    vec3 radiance = surface.emissive;

    if (u_has_irradiance != 0)
    {
        vec3 irradiance_direction = RotateAroundY(normal, u_skybox_yaw_radians);
        vec3 irradiance = texture(u_irradiance_cubemap, irradiance_direction).rgb * max(u_skybox_intensity, 0.0);
        radiance += kD * irradiance * surface.albedo;
    }

    if (u_has_specular_ibl != 0)
    {
        vec3 R = reflect(-V, normal);
        vec3 prefiltered_color = SampleEnvironmentIncidentRadiance(R, surface.roughness);
        vec2 env_brdf = texture(u_brdf_lut, vec2(ndotv, clamp(surface.roughness, 0.0, 1.0))).rg;
        radiance += prefiltered_color * (F * env_brdf.x + env_brdf.y);
    }

    return radiance;
}

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float depth = texture(u_gbuffer_depth, uv).r;
    if (depth >= 1.0)
    {
        imageStore(o_reflection_radiance, pixel, vec4(0.0));
        return;
    }

    vec4 rt0 = texture(u_gbuffer_rt0, uv);
    vec4 rt1 = texture(u_gbuffer_rt1, uv);
    vec3 normal = normalize(rt1.xyz * 2.0 - 1.0);
    vec3 albedo = clamp(rt0.rgb, 0.0, 1.0);
    float metallic = clamp(rt0.a, 0.0, 1.0);
    float roughness = clamp(rt1.a, 0.0, 1.0);

    vec3 world_position = ReconstructWorldPosition(uv, depth);
    vec3 V = normalize(u_camera_position - world_position);
    vec3 F0 = mix(vec3(0.04), albedo, metallic);
    ReflectionSample sample = SamplePrimaryReflection(pixel, normal, V, F0, roughness);
    vec3 reflection_direction = normalize(sample.direction);
    vec3 ray_origin = world_position + normal * u_normal_bias + reflection_direction * u_normal_bias;

    vec3 radiance = SampleEnvironmentDirectionRadiance(reflection_direction);

    for (uint layer = 0u; layer < kMaxTransparentLayers; ++layer)
    {
        RayHit hit;
        if (!TraceClosestHit(ray_origin, reflection_direction, u_tlas_node_count, 1e30, hit))
        {
            break;
        }

        HitGeometry geo = FetchHitGeometry(hit);
        if (!PassesAlphaTest(geo.material_index, geo.uv0, geo.uv1))
        {
            ray_origin = geo.world_position + reflection_direction * u_normal_bias;
            continue;
        }

        ShadedSurface surface = FetchSurface(geo.material_index, geo.uv0, geo.uv1);
        radiance = ShadeSecondaryHit(geo, surface, -reflection_direction);
        break;
    }

    vec3 reflection_radiance = clamp(radiance * sample.weight, 0.0, kRadianceClamp);
    imageStore(o_reflection_radiance, pixel, vec4(reflection_radiance, 1.0));
}
