#version 460 core

// Temporal accumulation for the reflection radiance buffer (rgba16f, single
// layer). Reprojects each pixel into the previous frame and blends with an
// exponential moving average; rejects history on disocclusion.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(rgba16f, binding = 0) uniform writeonly image2D o_history;

uniform sampler2D u_radiance_current;
uniform sampler2D u_history_prev;
uniform sampler2D u_gbuffer_depth;
uniform sampler2D u_gbuffer_rt1;
uniform sampler2D u_gbuffer_depth_prev;
uniform sampler2D u_gbuffer_rt1_prev;

uniform mat4 u_inv_view;
uniform mat4 u_inv_projection;
uniform mat4 u_prev_view_projection;

uniform uvec2 u_output_size;
uniform float u_alpha;
uniform uint  u_history_valid;
uniform float u_camera_near;
uniform float u_camera_far;
uniform float u_depth_tolerance;
uniform float u_normal_tolerance;

float LinearizeDepth(float ndc_z_01)
{
    float z_n = ndc_z_01 * 2.0 - 1.0;
    return (2.0 * u_camera_near * u_camera_far) /
           (u_camera_far + u_camera_near - z_n * (u_camera_far - u_camera_near));
}

vec3 DecodeNormal(vec3 enc) { return normalize(enc * 2.0 - 1.0); }

void main()
{
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (pixel.x >= int(u_output_size.x) || pixel.y >= int(u_output_size.y))
    {
        return;
    }

    vec2  uv    = (vec2(pixel) + vec2(0.5)) / vec2(u_output_size);
    float depth = texture(u_gbuffer_depth, uv).r;

    bool reproject           = (u_history_valid != 0u) && (depth < 1.0);
    vec2  prev_uv            = vec2(0.0);
    float expected_prev_ndc_z = 0.0;

    if (reproject)
    {
        vec4 ndc  = vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
        vec4 view = u_inv_projection * ndc;
        view /= max(view.w, 1e-5);
        vec3 world_pos = (u_inv_view * vec4(view.xyz, 1.0)).xyz;

        vec4 prev_clip = u_prev_view_projection * vec4(world_pos, 1.0);
        if (prev_clip.w > 1e-4)
        {
            vec3 prev_ndc      = prev_clip.xyz / prev_clip.w;
            prev_uv            = prev_ndc.xy * 0.5 + 0.5;
            expected_prev_ndc_z = prev_ndc.z * 0.5 + 0.5;
            if (any(lessThan(prev_uv, vec2(0.0))) || any(greaterThan(prev_uv, vec2(1.0))))
            {
                reproject = false;
            }
        }
        else
        {
            reproject = false;
        }
    }

    // Snap to nearest texel — same reasoning as the shadow accumulation pass.
    ivec2 prev_pixel = ivec2(floor(prev_uv * vec2(u_output_size)));
    prev_pixel = clamp(prev_pixel, ivec2(0), ivec2(u_output_size) - ivec2(1));

    if (reproject)
    {
        float prev_depth_ndc = texelFetch(u_gbuffer_depth_prev, prev_pixel, 0).r;
        if (prev_depth_ndc >= 1.0)
        {
            reproject = false;
        }
        else
        {
            float prev_linear_z     = LinearizeDepth(prev_depth_ndc);
            float expected_linear_z = LinearizeDepth(expected_prev_ndc_z);
            float dz_rel = abs(prev_linear_z - expected_linear_z) / max(expected_linear_z, 1e-4);
            if (dz_rel > u_depth_tolerance)
            {
                reproject = false;
            }
            else
            {
                vec3 cur_normal  = DecodeNormal(texelFetch(u_gbuffer_rt1,      pixel,      0).xyz);
                vec3 prev_normal = DecodeNormal(texelFetch(u_gbuffer_rt1_prev, prev_pixel, 0).xyz);
                if (dot(cur_normal, prev_normal) < u_normal_tolerance)
                {
                    reproject = false;
                }
            }
        }
    }

    float alpha = reproject ? clamp(u_alpha, 0.0, 0.999) : 0.0;

    vec3 current    = texture(u_radiance_current, uv).rgb;
    vec3 history    = reproject ? texelFetch(u_history_prev, prev_pixel, 0).rgb : current;
    vec3 accumulated = mix(current, history, alpha);
    imageStore(o_history, pixel, vec4(accumulated, 1.0));
}
